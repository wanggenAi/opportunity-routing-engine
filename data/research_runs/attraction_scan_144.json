      "formation_id": "ATTRACTION_SCAN_144-F1",
      "title": "Chinese industrial-equipment exporters with thin overseas service coverage -> local independent field-service / commissioning capacity",
      "seed_kind": "BROAD_REALITY_PATTERN",
